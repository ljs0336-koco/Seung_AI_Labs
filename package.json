{
  "name": "ai-literacy-lab-vite",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-content.mjs && node scripts/check-magazine.mjs && npm run build:app",
    "build:app": "npm run check:privacy && vite build --configLoader native && node scripts/check-public-privacy.mjs dist",
    "manage": "node --use-system-ca scripts/content-manager.mjs",
    "test:content": "node --test scripts/content-store.test.mjs scripts/build-share-pages.test.mjs",
    "check:privacy": "node scripts/check-public-privacy.mjs public src index.html",
    "test:privacy": "node --test scripts/check-public-privacy.test.mjs",
    "privacy:install-hook": "git config core.hooksPath .githooks",
    "lint": "oxlint src",
    "preview": "vite preview",
    "test": "vitest"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^29.1.1",
    "oxlint": "^1.75.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.11"
  }
}
